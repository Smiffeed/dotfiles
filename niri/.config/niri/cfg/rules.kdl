    window-rule {
        geometry-corner-radius 20 // Set every window radius to 20
        clip-to-geometry true
    }

    layer-rule {
        match namespace="^noctalia-wallpaper*"
        place-within-backdrop true
    }

    window-rule {
      match app-id="foot"
      match app-id="Alacritty"
      background-effect {
        blur true
        xray false
      }
    }

    window-rule {
        match app-id="dev.mohit.NiriSeek"
        open-floating true
    }

    window-rule {
        match app-id="^file_chooser$"
        open-floating true
        default-column-width { fixed 1000; }
        default-window-height { fixed 650; }
    }

    window-rule {
        match app-id="(?i)dragon"
        match app-id="(?i)ripdrag"
        open-floating true
    }

    window-rule {
        match app-id="(?i)fcitx"
        open-floating true
        focus-ring {
            off
        }
        border {
            off
        }
        shadow {
            off
        }
    }
